{
  "image": {
    "type": "textbox",
    "text": "Your image URL (or put bg.jpg in this folder)",
    "value": "https://i.pinimg.com/736x/d6/6f/fc/d66ffcd7db47d11e20954592bfdaad25.jpg"
  },
  "fit": {
    "type": "dropdown",
    "text": "Fit",
    "value": 0,
    "items": ["Fill screen (crop)", "Fit whole image"]
  },
  "weather": {
    "type": "dropdown",
    "text": "Weather",
    "value": 1,
    "items": ["Rain", "Snow", "Mist", "Embers", "None"]
  },
  "intensity": {
    "type": "slider", "text": "Weather intensity",
    "value": 72, "min": 0, "max": 100, "step": 1
  },
  "fog": {
    "type": "slider", "text": "Mist / blowing haze",
    "value": 30, "min": 0, "max": 100, "step": 1
  },
  "wind": {
    "type": "slider", "text": "Wind (left ↔ right)",
    "value": 60, "min": 0, "max": 100, "step": 1
  },
  "grade": {
    "type": "dropdown", "text": "Colour grade",
    "value": 0,
    "items": ["None", "Cool", "Warm", "Noir"]
  },
  "vignette": {
    "type": "slider", "text": "Vignette",
    "value": 50, "min": 0, "max": 100, "step": 1
  },
  "grain": {
    "type": "slider", "text": "Film grain",
    "value": 26, "min": 0, "max": 100, "step": 1
  },
  "parallax": {
    "type": "checkbox", "text": "Mouse parallax", "value": true
  },
  "drift": {
    "type": "checkbox", "text": "Cinematic drift (slow zoom)", "value": true
  }
}
